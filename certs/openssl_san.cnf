[req]
default_bits = 2048
prompt = no
default_md = sha256
req_extensions = req_ext
distinguished_name = dn

[dn]
C = MX
ST = CDMX
L = Ciudad de Mexico
O = AnaliticaSoft
OU = IDA System Peripherals
CN = ida-peripheral.local

[req_ext]
subjectAltName = @alt_names

[alt_names]
DNS.1 = localhost
DNS.2 = *.local
DNS.3 = ida.local
DNS.4 = ida-peripheral.local
IP.1 = 127.0.0.1
IP.2 = ::1
IP.3 = 192.168.1.100
IP.4 = 192.168.0.1
IP.5 = 192.168.1.1
IP.6 = 10.0.0.1
IP.7 = 172.16.0.1
