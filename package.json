{
  "name": "driver",
  "version": "2.0.0",
  "description": "IDA Print Driver: reliable, tenant-scoped ESC/POS printing agent",
  "main": "agente.js",
  "scripts": {
    "start": "node agente.js",
    "check": "node --check agente.js && node --check lib/runtime.js && node --check lib/queue.js && node --check lib/format.js",
    "build:win": "pkg . --targets node22-win-x64 --output dist/ida-print-driver.exe",
    "build:linux": "pkg . --targets node22-linux-x64 --output dist/ida-print-driver",
    "release:check": "npm ci && npm run check && npm test -- --runInBand && npm audit --omit=dev",
    "test": "npx jest --runInBand",
    "test:ci": "npx jest --ci --runInBand --coverage --coverageDirectory=reports/coverage"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10"
  },
  "bin": "agente.js",
  "files": [
    "agente.js",
    "lib/**/*.js",
    "certs/*.crt",
    "README.md"
  ],
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.14.0",
    "chalk": "^4.1.2",
    "inquirer": "^8.2.7",
    "node-thermal-printer": "^4.6.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.5.0",
    "jest": "^29.7.0"
  }
}
